# Build the data caches of new train/valid/test splits, ONE job per split seed.
#
#   condor_submit batch/prepare_split.sub
#
# Run it, and wait until every job has finished, BEFORE submitting any study job
# with DATA_SPLIT_SEED: those jobs refuse to start until the job here has written
# mlready/<processor>_default_split<seed>/splits/split_info.yaml. The jobs of
# different seeds write different cache folders, so they run side by side.
#
# They write straight into the staged data on EOS (PROJECT_ROOT in
# batch/_stage_env.sh), about 15-20 GB per split.

executable = batch/prepare_split.sh

log    = batch/logs/prepare_split.$(ClusterId).log
output = batch/logs/prepare_split.$(ClusterId).$(ProcId).out
error  = batch/logs/prepare_split.$(ClusterId).$(ProcId).err

MY.SingularityImage = "/eos/user/l/lbehrens/containers/adl1t_lab-dev.sif"

environment = "DATA_SPLIT_SEED=$(DATA_SPLIT_SEED) TRAINER=cpu CPU_THREADS=4 DATA_WORKERS=3"

request_gpus   = 0
# Measured on cluster 835372 (seeds 666 and 1, 2026-10-28): peak 10941 MB and
# 10754 MB, CPU use 0.7-0.9 cores (bound by EOS I/O), 28-33 min wall time.
# 12000 MB = 4 x 3000 MB per core keeps CERN from rescaling the request.
request_cpus   = 4
request_memory = 12000
request_disk   = 10GB

# About 30 min measured; EOS can be much slower under load.
+MaxRuntime = 10800

# EOS returns transient I/O errors under load; a rerun reuses what is finished.
on_exit_remove = (ExitBySignal == False && ExitCode == 0) || (NumJobStarts >= 3)

queue DATA_SPLIT_SEED in (666, 1)
