executable = batch/runae.sh

log    = batch/logs/runae.$(ClusterId).log
output = batch/logs/runae.$(ClusterId).$(ProcId).out
error  = batch/logs/runae.$(ClusterId).$(ProcId).err

MY.SingularityImage = "/eos/user/l/lbehrens/containers/adl1t_lab-dev.sif"

# ---------------------------------------------------------------------------
# Output transfer
# ---------------------------------------------------------------------------
# HTCondor only transfers back top-level files in the sandbox by default -
# never subdirectories. Without this line the checkpoints and MLflow logs in
# outputs/ are discarded when the job ends (job 329299 returned only 89 KB of
# stdout/stderr). EosSubmit assumes preserve_relative_paths=True, so the tree
# lands as outputs/ under the submit directory.
transfer_output_files = outputs

# ---------------------------------------------------------------------------
# Resources
# ---------------------------------------------------------------------------
# CPU-only (supervisor decision, 2026-09-18). Dropping request_gpus also drops
# CERN's "Hostgroup == bi/condor/gridworker/gpu" requirement, which is what
# confined this job to a handful of slots: at 30000/10 the whole GPU pool
# offered 9 slots that could ever host it. The shared CPU pool is ~5200 slots.
request_gpus = 0

# CERN allocates 3000 MB of RAM per core and rescales request_cpus upward to
# cover request_memory, so keep memory == cpus * 3000 or both get rewritten.
#
# Measured on job 329299 (succeeded, 3 epochs in 9 min):
#   train model input   (12532307, 116) float32  ~5.8 GB
#   train control tensor (12532307, 39, 3)       ~5.9 GB
#   + validation and 20 signal datasets for evaluation
# Peak RSS was 30265 MB with a 30000 MB request; it OOM'd at 12000 MB.
# DATA_WORKERS does not change this (3 workers -> 14256 MB, 1 worker -> 14289).
#
# 30000/10 is kept here deliberately, unlike batch/runpareto.sub which runs an
# under-request of 24000/8 to reach the 24600 MB slot shape. This job's purpose
# is to measure true peak RSS, so it must not be constrained by its own limit:
# a job that is killed, or that adapts to pressure, measures the limit rather
# than the requirement. Read the measured peak from the [mem] lines afterwards
# and size everything else from that.
#
# Fleet sizes, single GPU:
#   4 cpus / 12000 MB  -> ~136 machines, but OOMs
#   10 cpus / 30000 MB -> ~92 machines, PROVEN to work
#   13 cpus / 39000 MB -> ~92 machines (same pool, more headroom)
#   22 cpus / 66000 MB -> ~32 machines, never scheduled
request_cpus   = 10
request_memory = 30000
request_disk   = 10GB

# 3 h for a 30-epoch run.
#
# Job 329299 did 3 epochs in 9 min wall: ~3.5 min data conversion, 33 s/epoch,
# ~1.5 min evaluation. Extrapolating the epochs alone gives ~5 min fixed
# overhead + 30 x 33 s = ~22 min, but a Pareto shard on 2026-09-18 took 50 min
# for one 30-epoch run, so the per-epoch cost in a full evaluation-enabled run
# is well above the 33 s measured over three epochs. 10800 s leaves room for
# that without risking a mid-run eviction, which is silent: an evicted job
# leaves no hold reason, it simply disappears from the queue.
#
# This run exists to replace those extrapolations with a measurement. The job
# logs per-phase wall time and peak RSS, so the next sizing decision can be
# made from data rather than inference.
# CPU is expected to be slower per epoch than the H100 MIG baseline; how much
# slower is exactly what this run measures. 4 h leaves room for a bad surprise,
# since an over-runtime job is evicted silently - no hold, no reason, it simply
# leaves the queue.
+MaxRuntime = 14400

queue
