executable = batch/runae.sh

log    = batch/logs/runae.$(ClusterId).log
output = batch/logs/runae.$(ClusterId).$(ProcId).out
error  = batch/logs/runae.$(ClusterId).$(ProcId).err

MY.SingularityImage = "/eos/user/l/lbehrens/containers/adl1t_lab-dev.sif"

request_gpus = 1

# These are required on the EosSubmit schedds. Without them HTCondor falls back
# to 3000 MB and a 3 KB sandbox, and the job gets held for exceeding memory.
# (The standard schedds rewrite these to a per-GPU unit; EosSubmit does not.)
# l40s-job.yaml asked for 64 Gi; 32 GB is a starting point for a 3-epoch run.
# Check actual usage afterwards with:
#   condor_history -l <jobid> | grep -i memoryusage
request_cpus   = 4
request_memory = 32000
request_disk   = 20000

# 2 h. test_container.sub used 600 s; 3 epochs needs more.
+MaxRuntime = 7200

queue
