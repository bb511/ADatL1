executable = batch/runae.sh

log    = batch/logs/runae.$(ClusterId).log
output = batch/logs/runae.$(ClusterId).$(ProcId).out
error  = batch/logs/runae.$(ClusterId).$(ProcId).err

MY.SingularityImage = "/eos/user/l/lbehrens/containers/adl1t_lab-dev.sif"

request_gpus = 1

# CERN allocates 3000 MB of RAM per core and scales RequestCpus up to cover
# request_memory: asking for 32000 forced 11 cores and dropped the matching
# slots to zero. Keep memory == cpus * 3000 so nothing gets rescaled.
# request_memory is in MiB; request_disk defaults to KiB, hence the explicit GB.
# CERN caps memory at 3000 MB per core, so cpus and memory must stay in that
# ratio or HTCondor rescales them.
#
# 22 cpus / 66000 MB (64 GB) matched only 32 machines, all busy - 0 willing.
# 16 cpus / 48000 MB (48 GB) also reaches the 42-node 16-core/118 GB fleet,
# for ~75 machines total, and is still 3.4x the 14256 MB where job 329277 OOM'd.
#
# If this still shows 0 willing, cut the footprint rather than raising further:
#   environment = "DATA_WORKERS=1"
# with 4 cpus / 12000 MB puts you back on the 30-node 4-core fleet.
#
# Check the real peak once a run completes:
#   condor_history -l <jobid> | grep -i memoryusage
request_cpus   = 16
request_memory = 48000
request_disk   = 10GB

# 2 h. test_container.sub used 600 s; 3 epochs needs more.
+MaxRuntime = 7200

queue
