executable = batch/runae.sh

log    = batch/logs/runae.$(ClusterId).log
output = batch/logs/runae.$(ClusterId).$(ProcId).out
error  = batch/logs/runae.$(ClusterId).$(ProcId).err

MY.SingularityImage = "/eos/user/l/lbehrens/containers/adl1t_lab-dev.sif"

request_gpus = 1

# CERN allocates 3000 MB of RAM per core and scales RequestCpus up to cover
# request_memory: asking for 32000 forced 11 cores and dropped the matching
# slots to zero. Keep memory == cpus * 3000 so nothing gets rescaled.
# request_memory is in MiB; request_disk defaults to KiB, hence the explicit GB.
# l40s-job.yaml asked for 64 Gi, but the dataset streams (L1ADDataset.__iter__)
# so 12 GB should be ample for 3 epochs. If the job is held for memory, step up
# to 6 cpus / 18000 MB. Check real usage with:
#   condor_history -l <jobid> | grep -i memoryusage
request_cpus   = 4
request_memory = 12000
request_disk   = 10GB

# 2 h. test_container.sub used 600 s; 3 epochs needs more.
+MaxRuntime = 7200

queue
