executable = batch/runae.sh

log    = batch/logs/runae.$(ClusterId).log
output = batch/logs/runae.$(ClusterId).$(ProcId).out
error  = batch/logs/runae.$(ClusterId).$(ProcId).err

MY.SingularityImage = "/eos/user/l/lbehrens/containers/adl1t_lab-dev.sif"

# ---------------------------------------------------------------------------
# Output transfer
# ---------------------------------------------------------------------------
# HTCondor only transfers back top-level files in the sandbox by default -
# never subdirectories. Without this line the checkpoints and MLflow logs in
# outputs/ are discarded when the job ends (job 329299 returned only 89 KB of
# stdout/stderr). EosSubmit assumes preserve_relative_paths=True, so the tree
# lands as outputs/ under the submit directory.
transfer_output_files = outputs

# ---------------------------------------------------------------------------
# Resources
# ---------------------------------------------------------------------------
request_gpus = 1

# CERN allocates 3000 MB of RAM per core and rescales request_cpus upward to
# cover request_memory, so keep memory == cpus * 3000 or both get rewritten.
#
# Measured on job 329299 (succeeded, 3 epochs in 9 min):
#   train model input   (12532307, 116) float32  ~5.8 GB
#   train control tensor (12532307, 39, 3)       ~5.9 GB
#   + validation and 20 signal datasets for evaluation
# Peak RSS was 30265 MB with a 30000 MB request; it OOM'd at 12000 MB.
# DATA_WORKERS does not change this (3 workers -> 14256 MB, 1 worker -> 14289).
#
# Fleet sizes, single GPU:
#   4 cpus / 12000 MB  -> ~136 machines, but OOMs
#   10 cpus / 30000 MB -> ~92 machines, PROVEN to work
#   13 cpus / 39000 MB -> ~92 machines (same pool, more headroom)
#   22 cpus / 66000 MB -> ~32 machines, never scheduled
request_cpus   = 10
request_memory = 30000
request_disk   = 10GB

# 2 h. Job 329299 took 9 min wall: ~3.5 min data conversion, 33 s/epoch,
# ~1.5 min evaluation. Subsequent runs skip the conversion because
# torch_cache.pt is now cached on EOS.
+MaxRuntime = 7200

queue
