# STAGE 1, resume of the 1000-epoch run (gamma 0.1, 80 bins) from a checkpoint.
#
#   condor_submit batch/runae_ep1000_resume.sub
#
# Why this exists: cluster 399035 (batch/runae_ep1000.sub) trained all 1000
# epochs in ~26 h and then lost everything at the output transfer, 2026-10-06
# 21:21 (hold code 12, subcode 256):
#   [3010] Unable to give access - user access restricted -
#   unauthorized identity used: Permission denied
# on the very first file. That is EOS rejecting the job's identity, not the
# transient kXR_write error of cluster 353645. It struck ~26 h after the start,
# just past the 25 h lifetime of a CERN Kerberos ticket, while every 200-epoch
# job (<= ~13 h) transferred fine. A job here must therefore finish, transfer
# included, well inside ~24 h. The automatic retry started again from epoch 0.
#
# This job continues from the last.ckpt copied out of the running sandbox with
#   condor_ssh_to_job -name bigbird103.cern.ch -ssh scp <job> remote:<ckpt> <dest>
# and so needs only the remaining epochs (~1.5 min each on a typical node).
#
# Identical to batch/runae_ep1000.sub (same RUN_NAME, experiment, data, model,
# manifest, MAX_EPOCHS=1000) except for:
#   - CKPT_PATH in the environment. scripts/physics/runae.sh turns it into
#     ckpt_path=... callbacks.clear_ckpts=null, so Lightning restores weights,
#     optimizer, scheduler and the epoch counter and trains on to 1000.
#   - +MaxRuntime of one day instead of one week (see below).
#   - its own log file names.
#
# loss_total.ckpt: Apptainer mounts every sandbox at /srv, so the checkpoint
# dirpath (/srv/outputs/checkpoints/...) is the same in every job and Lightning
# restores ModelCheckpoint's best_model_score from last.ckpt. loss_total.ckpt is
# therefore rewritten only if an epoch after the resume point beats the best one
# before it. If this job returns no loss_total.ckpt, the overall best is the
# loss_total.ckpt copied next to the resume checkpoint; copy that one in.
#
# Do not git pull on EOS while this job runs. CODE_DIR is the live checkout:
# Hydra composes the config at the start, but the evaluation callbacks are
# imported only after fit. Cluster 401253 (2026-10-07) trained to epoch 1000 and
# then failed instantiating LatentCollapseDiagnosticsCallback, whose
# paired_reference argument a2cf5ba had removed in the meantime.
#
# Caveat, MLflow: this job logs a new MLflow run with the epochs after the
# resume point only. Epochs before it are in the sandbox copy taken with the
# checkpoint; the two are stitched together locally.

executable = batch/runae_pareto.sh

log    = batch/logs/runae_ep1000_resume.$(ClusterId).log
output = batch/logs/runae_ep1000_resume.$(ClusterId).$(ProcId).out
error  = batch/logs/runae_ep1000_resume.$(ClusterId).$(ProcId).err

MY.SingularityImage = "/eos/user/l/lbehrens/containers/adl1t_lab-dev.sif"

environment = "SEED=$(SEED) MI_GAMMA=$(GAMMA) MI_NUM_BINS=$(BINS) ARCHITECTURE_ID=$(ARCH) ENCODER_NODES_US=$(NODES) RUN_NAME=$(RUN_NAME) MAX_EPOCHS=1000 EXPERIMENT=physics/pareto_fet_train TRAINER=cpu CPU_THREADS=6 DATA_WORKERS=3 CKPT_PATH=/eos/user/l/lbehrens/adatl1/ep1000_backup/resume_from/last.ckpt"

# ---------------------------------------------------------------------------
# Output transfer
# ---------------------------------------------------------------------------
# Required: HTCondor returns only top-level sandbox files, never subdirectories.
# Each job writes a disjoint path, checkpoints/<experiment_name>/<run_name>/, so
# the 96 returned trees merge by union into one experiment directory -- which is
# exactly what stage 4 then reads, via the run_manifest.yaml each one carries.
transfer_output_files = outputs

# ---------------------------------------------------------------------------
# Resources
# ---------------------------------------------------------------------------
request_gpus = 0

# CERN allocates 3000 MB per core and rescales request_cpus upward to cover
# request_memory, so keep memory == cpus * 3000 or both get rewritten.
#
# Sizing chain, each step measured rather than assumed:
#   29724 MiB  job 333170, before the control-tensor view change
#   15273 MB   job 333797, after it (ResidentSetSize 15,638,908 KB)
#   10336 MiB  cluster 333975, with the auxiliary datasets dropped from fit
#
# That last configuration is reverted: stage 1 runs the full post-fit evaluation
# again, which needs the auxiliary datasets AND the operational threshold that
# the anomaly_eff training callback stores on the module (and hence into the
# checkpoint, which stage 3 later depends on). So the working set is the 15273 MB
# figure, not 10336, and 18000 gives about 18% headroom on a measurement.
#
# 18000/6 still reaches far more of the pool than the 21000/7 it replaces, and
# unlike 15000/5 it is not below the measured peak. A request under the real
# working set does not fail cleanly here -- CERN's cgroup limit on this pool is
# soft, so the job runs on and is evicted silently much later.
request_cpus   = 6
request_memory = 18000
request_disk   = 10GB

# One day, not the week of batch/runae_ep1000.sub: past ~25 h the output
# transfer is refused anyway (see the header), so a longer allowance only wastes
# a slot. ~500 remaining epochs take ~12 h on a typical node. Check the speed
# after the first hour; on a node that is 2-3x slower, condor_rm and resubmit
# this file, which starts again from the same checkpoint.
+MaxRuntime = 86400

# Retry failed jobs automatically, up to 3 starts in total; a retry resumes from
# the same CKPT_PATH, not from epoch 0. EOS returns
# transient "Input/output error" (errno 5/121) under load when many jobs read
# the data or write logs at once; all such failures in clusters 354142/354543
# succeeded on a plain rerun. Success is exit code 0.
on_exit_remove = (ExitBySignal == False && ExitCode == 0) || (NumJobStarts >= 3)

# Hold code 12 = output transfer to EOS failed (kXR_write / "Unable to store
# file", cluster 353645: 5 of 111 jobs). Release such jobs automatically; the
# job retrains from CKPT_PATH and transfers again. At most 3 starts.
periodic_release = (HoldReasonCode == 12) && (NumJobStarts < 3)

queue SEED,GAMMA,BINS,ARCH,NODES,RUN_NAME from batch/pareto_runs_ep1000.txt
