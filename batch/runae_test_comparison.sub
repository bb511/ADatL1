# The gamma = 0 comparison of tested runs, as one HTCondor job
# (scripts/physics/runae_test_comparison.sh via batch/runae_test_comparison.sh).
# Submit after the runs AND their gamma = 0 / 50-bin run have been tested
# (batch/runae_test.sub).
#
#   condor_submit batch/runae_test_comparison.sub                        # runs in batch/test_runs.txt
#   condor_submit RUNS=batch/my_runs.txt batch/runae_test_comparison.sub
#   condor_submit "RUN_NAMES=RunA RunB" batch/runae_test_comparison.sub   # names instead of a file
#   condor_submit EXPERIMENT_NAME=Pareto-Front-260928 ... batch/runae_test_comparison.sub
#   condor_submit FORCE=1 ... batch/runae_test_comparison.sub            # redraw existing comparison_gamma0/

executable = batch/runae_test_comparison.sh
arguments  = $(RUN_NAMES)

log    = batch/logs/runae_test_comparison.$(ClusterId).log
output = batch/logs/runae_test_comparison.$(ClusterId).out
error  = batch/logs/runae_test_comparison.$(ClusterId).err

MY.SingularityImage = "/eos/user/l/lbehrens/containers/adl1t_lab-dev.sif"

environment = "EXPERIMENT_NAME=$(EXPERIMENT_NAME) RUNS=$(RUNS) FORCE=$(FORCE) TRAINER=cpu CPU_THREADS=1 DATA_WORKERS=1"

# No transfer_output_files: everything is written beside the runs on EOS.

# Tables and plots only: no torch, no data loading.
request_gpus   = 0
request_cpus   = 1
request_memory = 2000
request_disk   = 1GB

+MaxRuntime = 1800

# Retry transient EOS I/O errors, up to 3 starts in total.
on_exit_remove = (ExitBySignal == False && ExitCode == 0) || (NumJobStarts >= 3)

queue
