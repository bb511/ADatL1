# STAGE 2 of 4 -- the four leakage probes, one job per run.
#
# Submit with a list of run names, one per line, in batch/runs.txt:
#   condor_submit batch/runprobes.sub
#
# Stage 2 and stage 3 read the same checkpoint and write into disjoint
# subdirectories, so both may be submitted at the same time.

executable = batch/runprobes.sh

log    = batch/logs/runprobes.$(ClusterId).log
output = batch/logs/runprobes.$(ClusterId).$(ProcId).out
error  = batch/logs/runprobes.$(ClusterId).$(ProcId).err

MY.SingularityImage = "/eos/user/l/lbehrens/containers/adl1t_lab-dev.sif"

# RUN_NAME is per-job and comes from the queue statement at the bottom.
environment = "RUN_NAME=$(RUN_NAME) EXPERIMENT=physics/ae PROBE_MODE=validation CPU_THREADS=8"

# ---------------------------------------------------------------------------
# Output transfer
# ---------------------------------------------------------------------------
# Deliberately absent. This job reads an existing checkpoint tree on EOS and
# writes its JSON and PNGs straight back into it, so there is nothing in the
# sandbox to bring home. Adding transfer_output_files = outputs here would
# return an empty directory and, worse, invite a later merge that overwrites
# the very tree this job just wrote into.

# ---------------------------------------------------------------------------
# Resources
# ---------------------------------------------------------------------------
# CPU-only; the probes are sklearn, which never touches the GPU at all.
request_gpus = 0

# CERN allocates 3000 MB of RAM per core and rescales request_cpus upward to
# cover request_memory, so keep memory == cpus * 3000 or both get rewritten.
#
# v9 removes the full-matrix linear-solve and held-out-prediction copies.  The
# reconstruction MLP's early-stopping split is now the binding allocation.
# CERN maps 24 GB to an 8-core slot at 3 GB/core; keep these values aligned.
request_cpus   = 8
request_memory = 24000
request_disk   = 10GB

# The 16,384-row MLP batch is a protocol change and needs a fresh timing run;
# four hours retains enough headroom for a slow worker while that is measured.
+MaxRuntime = 14400

queue RUN_NAME from batch/runs.txt
