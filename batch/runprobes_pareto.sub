# STAGE 2 of the Pareto study -- the four leakage probes, one job per grid point.
#
#   condor_submit batch/runprobes_pareto.sub
#
# Submit only after the stage-1 outputs have been merged onto EOS. May be
# submitted at the same time as batch/runmetrics_pareto.sub: the two read the
# same checkpoint and write into disjoint subdirectories of it.

executable = batch/runprobes_pareto.sh

log    = batch/logs/runprobes_pareto.$(ClusterId).log
output = batch/logs/runprobes_pareto.$(ClusterId).$(ProcId).out
error  = batch/logs/runprobes_pareto.$(ClusterId).$(ProcId).err

MY.SingularityImage = "/eos/user/l/lbehrens/containers/adl1t_lab-dev.sif"

environment = "SEED=$(SEED) MI_GAMMA=$(GAMMA) MI_NUM_BINS=$(BINS) ARCHITECTURE_ID=$(ARCH) ENCODER_NODES_US=$(NODES) RUN_NAME=$(RUN_NAME) TRAINER=cpu CPU_THREADS=8 DATA_WORKERS=3"

# No transfer_output_files: this job writes its JSON and PNGs straight into the
# existing checkpoint tree on EOS, so there is nothing in the sandbox to return.

request_gpus = 0

# v9 streams linear least squares and all held-out predictions, verifies the
# binary latent sample without retaining it, and preallocates extraction arrays.
# The binding MLP fit still retains its own early-stopping split of the 116-wide
# train representation.  24 GB gives that fit headroom; CERN's 3 GB/core rule
# therefore requires an 8-core slot.  Probes remain deliberately sequential.
request_cpus   = 8
request_memory = 24000
request_disk   = 10GB

# The first smoke used 6,649 s of a 7,200 s cap.  The larger MLP batch changes
# the optimization trajectory and a slow worker can still exceed two hours.
+MaxRuntime = 14400

queue SEED,GAMMA,BINS,ARCH,NODES,RUN_NAME from batch/pareto_runs.txt
