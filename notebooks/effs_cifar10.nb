Cell[CellGroupData[{

Cell["Legacy Pareto Point Selection (by hand)", "Section",ExpressionUUID->"69b05f0c-a104-4d1a-9fbd-57ae3cc7c16a"],

Cell["\<\
cifarArchitectures = Association[\"AE\" -> Association[\"semisupervised\" -> \
{14.7, 1.7, 7.9, 8.7, 6.4, 1.9, 5.3, 4.1, 14.3}, \"CAP\" -> {13.8, 1.3, 7., \
4.9, 8.2, 1., 5.6, 3.2, 13.2}, \"stable\" -> {10.3, 0.8, 4.6, 6.5, 3.9, 1.1, \
3.6, 2.8, 11.6}, \"wasserstein\" -> {9.9, 0.7, 4.3, 6.2, 3.5, 0.8, 3.7, 2.6, \
10.8}], \"VAE\" -> Association[\"semisupervised\" -> {4.9, 1.8, 5.4, 2.5, 6., \
0.8, 6.3, 2.8, 4.9}, \"CAP\" -> {0.6, 0.2, 1.2, 0.2, 1.1, 0.8, 2.5, 0.9, \
0.3}, \"stable\" -> {0., 0.2, 0., 0., 0., 0., 0., 0.3, 0.}, \"wasserstein\" \
-> {0.4, 0., 0.4, 1.4, 1.2, 1., 1.3, 1.3, 2.1}], \"SVDD\" -> \
Association[\"semisupervised\" -> {4.6, 0.4, 3.3, 5.7, 2.4, 1.9, 1.5, 3.9, \
5.2}, \"CAP\" -> {2.2, 0.2, 1.1, 0.4, 0.3, 0., 0.6, 0.6, 3.1}, \"stable\" -> \
{3.1, 0.9, 1.9, 1.8, 1.8, 0.6, 1.2, 1.9, 2.9}, \"wasserstein\" -> {0., 0., \
0., 0., 0., 0., 0., 0., 0.}], \"RealNVP\" -> Association[\"semisupervised\" \
-> {7.6, 1.4, 10.5, 20.7, 6.1, 11.7, 6.9, 8.4, 9.7}, \"CAP\" -> {5.6, 1.1, \
6., 8.5, 5.4, 5.1, 4.9, 4.7, 5.8}, \"stable\" -> {2.8, 1.1, 3.8, 6.9, 3.6, \
4.4, 2.8, 3.8, 3.5}, \"wasserstein\" -> {8.2, 0.7, 5.8, 3.3, 6.4, 1.1, 5.7, \
2.6, 7.2}]];\
\>", "Input",
 CellLabel->
  "In[191]:=",ExpressionUUID->"a6d59506-219f-450d-9716-6d29b3008886"],

Cell[CellGroupData[{

Cell["\<\
cifarTableTex = BuildLatexTableCompactAsymCollapse[cifarArchitectures, 10000, \
0.05, 2];
printTable[cifarTableTex];
printTable[BuildMarkdownTableCompactAsymCollapse[cifarArchitectures, 10000, 0.05, \
2]];\
\>", "Input",
 CellLabel->
  "In[192]:=",ExpressionUUID->"241a9099-fa7a-4f54-aeab-3004d33e893c"],

Cell[CellGroupData[{

Cell[BoxData["\<\"\\\\begin{tabular}{lcccccccc}\\n\\\\toprule\\nArch. & Semi \
& CAP & Stable & W1 & CAP$-$Stable & $p$ & CAP$-$W1 & $p$ \
\\\\\\\\\\n\\\\midrule\\nAE & 7.22 & 6.47 & 5.02 & 4.72 & \
