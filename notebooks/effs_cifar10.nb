     \"ae\" -> <|\"cap\" -> 175, \"cvar25\" -> 169, \"stability\" -> 564, \
\"wasserstein\" -> 584|>,
     \"vae\" -> <|\"cap\" -> 179, \"cvar25\" -> 345, \"stability\" -> 529, \
\"wasserstein\" -> 539|>,
     \"dsae\" -> <|\"cap\" -> 570, \"cvar25\" -> 599, \"stability\" -> 565, \
