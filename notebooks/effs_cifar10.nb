Cell[CellGroupData[{

Cell["Pareto Knee Selection", "Section",ExpressionUUID->"8327091b-4bc7-4c59-8258-400cdde875ac"],

Cell[CellGroupData[{

Cell["\<\
kneeGroups = rulePickArrays[rebuttalModelExps, kneePick];
kneeTabRows = HolmAdjustRows[BuildArchitectureRowsCompactCollapse[
   toLegacyGroups[kneeGroups], 10000, 0.05]];
printTable[LatexTableFromRows[kneeTabRows, 2]];
printTable[MarkdownTableFromRows[kneeTabRows, 2]];\
\>", "Input",
 CellLabel->
  "In[209]:=",ExpressionUUID->"4b641afa-f438-4f46-a032-5c837018292a"],

Cell[CellGroupData[{

Cell[BoxData["\<\"\\\\begin{tabular}{lcccccccc}\\n\\\\toprule\\nArch. & Semi \
& CAP & Stable & W1 & CAP$-$Stable & $p$ & CAP$-$W1 & $p$ \
\\\\\\\\\\n\\\\midrule\\nAE & 6.48 & 5.46 & no-pick & 5.54 & n/a & n/a & \
$-0.09^{+0.50}_{-0.54}$ & 1.000 \\\\\\\\\\nVAE & 1.23 & 0.79 & no-pick & \
no-pick & n/a & n/a & n/a & n/a \\\\\\\\\\nSVDD & no-pick & 0.30 & no-pick & \
coll & n/a & n/a & n/a & n/a \\\\\\\\\\nRealNVP & 13.46 & 4.13 & 4.22 & 1.21 \
& $-0.09^{+2.36}_{-2.80}$ & 1.000 & $2.92^{+1.29}_{-1.23}$ & 0.012 \
\\\\\\\\\\n\\\\bottomrule\\n\\\\end{tabular}\\n% legend: no-pick = rule could \
not select from this front (knee needs >= 3 Pareto points, best-Q' needs >= \
1); coll = method collapsed (all-zero) or excluded by the saturation guard; \
n/a = comparison not computable (a required side is missing).\"\>"], "Print",
 CellChangeTimes->{3.994219342413638*^9, 3.9942194265831823`*^9, 
  3.9942194690686913`*^9, 3.994221030970025*^9, 3.994225792981471*^9},
 CellLabel->
  "During evaluation of \
In[209]:=",ExpressionUUID->"d6835e24-8334-4f95-8e8b-e48b46fde21a"],

Cell[BoxData["\<\"| Arch. | Semi | CAP | Stable | W1 | CAP-Stable | p | \
CAP-W1 | p |\\n|---|---|---|---|---|---|---|---|---|\\n| AE | 6.48 | 5.46 | \
no-pick | 5.54 | n/a | n/a | $-0.09^{+0.50}_{-0.54}$ | 1.000 |\\n| VAE | 1.23 \
| 0.79 | no-pick | no-pick | n/a | n/a | n/a | n/a |\\n| SVDD | no-pick | \
0.30 | no-pick | coll | n/a | n/a | n/a | n/a |\\n| RealNVP | 13.46 | 4.13 | \
4.22 | 1.21 | $-0.09^{+2.36}_{-2.80}$ | 1.000 | $2.92^{+1.29}_{-1.23}$ | \
0.012 |\\n\\nlegend: no-pick = rule could not select from this front (knee \
needs >= 3 Pareto points, best-Q' needs >= 1); coll = method collapsed \
(all-zero) or excluded by the saturation guard; n/a = comparison not \
