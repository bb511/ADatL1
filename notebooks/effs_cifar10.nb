Export[rebuttalOutDir <> \"fronts_svdd\" <> rebuttalTierSuffix <> \".svg\", \
frontRowSVDD, \"SVG\"];
Export[rebuttalOutDir <> \"fronts_svdd\" <> rebuttalTierSuffix <> \".pdf\", \
frontRowSVDD, \"PDF\"];\
\>", "Input",ExpressionUUID->"85129fa4-3ed3-4166-b6a9-d83f5b637d9e"],

Cell["\<\
frontRowRealNVP = modelFrontRow[rebuttalFrontsDir, \"realnvp\", \"RealNVP\"]
Export[rebuttalOutDir <> \"fronts_realnvp\" <> rebuttalTierSuffix <> \
\".svg\", frontRowRealNVP, \"SVG\"];
Export[rebuttalOutDir <> \"fronts_realnvp\" <> rebuttalTierSuffix <> \
\".pdf\", frontRowRealNVP, \"PDF\"];\
\>", "Input",ExpressionUUID->"014c0460-4dca-48b7-b978-8de9573382ff"],

Cell["\<\
frontRowDTE = modelFrontRow[rebuttalFrontsDir, \"dte\", \"DTE\"]
Export[rebuttalOutDir <> \"fronts_dte\" <> rebuttalTierSuffix <> \".svg\", \
frontRowDTE, \"SVG\"];
Export[rebuttalOutDir <> \"fronts_dte\" <> rebuttalTierSuffix <> \".pdf\", \
frontRowDTE, \"PDF\"];\
\>", "Input",ExpressionUUID->"f0229083-4683-4b18-ab4f-0d1dd92176db"]
}, Closed]],

Cell[CellGroupData[{

Cell["Legacy Pareto Point Selection (by hand)", "Section",ExpressionUUID->"195a596a-df33-4ca7-a06b-44471af89a23"],

