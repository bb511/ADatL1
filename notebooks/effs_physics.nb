                    ";", "\n", "       ", 
                    RowBox[{"pick", " ", "=", " ", 
                    RowBox[{"pickF", "[", 
                    RowBox[{"front", ",", " ", "strat", ",", " ", "model"}], 
                    "]"}]}], ";", "\n", "       ", 
                    RowBox[{"oracle", " ", "=", " ", 
                    RowBox[{"oraclePick", "[", "front", "]"}]}], ";", "\n", 
                    "       ", 
                    RowBox[{"origTrial", " ", "=", " ", 
                    RowBox[{
                    RowBox[{"Query", "[", 
                    RowBox[{
                    RowBox[{"ToLowerCase", "[", "model", "]"}], ",", " ", 
                    "strat"}], "]"}], "[", "\n", "         ", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"originalPicks", ",", " ", "domain", ",", " ", 
                    RowBox[{"<|", "|>"}]}], "]"}], "]"}]}], ";", "\n", 
                    "       ", 
                    RowBox[{"orig", " ", "=", " ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"IntegerQ", "[", "origTrial", "]"}], ",", "\n", 
                    "         ", 
                    RowBox[{
                    "strat", " ", "<>", " ", "\"\<_t\>\"", " ", "<>", " ", 
                    RowBox[{"ToString", "[", "origTrial", "]"}]}], ",", " ", 
                    RowBox[{"Missing", "[", "\"\<NA\>\"", "]"}]}], "]"}]}], 
                    ";", "\n", "       ", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"rows", ",", " ", 
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<model\>\"", " ", "->", " ", "model"}], ",", 
                    " ", 
                    RowBox[{"\"\<strategy\>\"", " ", "->", " ", "strat"}], 
                    ",", "\n", "         ", 
                    RowBox[{"\"\<n\>\"", " ", "->", " ", 
                    RowBox[{"Length", "[", "front", "]"}]}], ",", " ", 
