       RowBox[{"sortedAbs", "=", 
        RowBox[{"absd", "[", 
         RowBox[{"[", "order", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sortedIdx", "=", "order"}], ";", "\[IndentingNewLine]", 
       RowBox[{"ranks", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"groups", "=", 
        RowBox[{"Split", "[", 
         RowBox[{
          RowBox[{"Range", "[", "n", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"sortedAbs", "[", 
             RowBox[{"[", "#1", "]"}], "]"}], "==", 
