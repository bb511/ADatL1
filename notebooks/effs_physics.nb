Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"strategyContextQ", "[", 
     RowBox[{"strat_String", ",", "ctx_String"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"StringStartsQ", "[", 
      RowBox[{"ctx", ",", "\"\<summary/eff/\>\""}], "]"}], "&&", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", "=", 
         RowBox[{"StringDrop", "[", 
          RowBox[{"ctx", ",", 
           RowBox[{"StringLength", "[", "\"\<summary/eff/\>\"", "]"}]}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"Switch", "[", 
        RowBox[{"strat", ",", "\"\<cvar25\>\"", ",", 
         RowBox[{"m", "===", "\"\<cvar25_ema/max\>\""}], ",", 
         "\"\<cvar10\>\"", ",", 
         RowBox[{"m", "===", "\"\<cvar10_ema/max\>\""}], ",", "\"\<cap\>\"", 
         ",", 
         RowBox[{
          RowBox[{"StringStartsQ", "[", 
           RowBox[{"m", ",", "\"\<cap_ema\>\""}], "]"}], "&&", 
          RowBox[{"StringEndsQ", "[", 
           RowBox[{"m", ",", "\"\</max\>\""}], "]"}]}], ",", 
         "\"\<stability\>\"", ",", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", 
           RowBox[{"m", ",", "\"\<drift_ema\>\""}], "]"}], "&&", 
          RowBox[{"StringEndsQ", "[", 
           RowBox[{"m", ",", "\"\</min\>\""}], "]"}]}], ",", 
         "\"\<wasserstein\>\"", ",", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", 
           RowBox[{"m", ",", "\"\<w1dist_ema\>\""}], "]"}], "&&", 
          RowBox[{"StringEndsQ", "[", 
           RowBox[{"m", ",", "\"\</min\>\""}], "]"}]}], ",", "_", ",", 
         "False"}], "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Per", "-", 
     RowBox[{"signal", " ", "eval", " ", 
      RowBox[{"columns", ":", 
       RowBox[{"eff_", "<", "label", ">", "_", "<", "dataset", ">"}]}]}]}], 
    ",", 
    RowBox[{
     RowBox[{"excluding", " ", "the", " ", "eff_med", 
      RowBox[{"_", "/", "eff_min"}], "_", " ", "summaries"}], ";", 
     RowBox[{
      RowBox[{"the", " ", "plain", " ", "eff_"}], "<", "label", ">", 
      RowBox[{"scalar", " ", "is", " ", "the", " ", "shortest", " ", 
       RowBox[{"prefix", "."}]}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"perSignalCols", "[", "hdr_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eff", ",", "base", ",", "cols"}], "}"}], ",", 
      RowBox[{
       RowBox[{"eff", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"hdr", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"StringQ", "[", "#", "]"}], "&&", 
            RowBox[{"StringStartsQ", "[", 
             RowBox[{"#", ",", "\"\<eff_\>\""}], "]"}], "&&", 
            RowBox[{"!", 
             RowBox[{"StringStartsQ", "[", 
              RowBox[{"#", ",", "\"\<eff_med_\>\""}], "]"}]}], "&&", 
            RowBox[{"!", 
             RowBox[{"StringStartsQ", "[", 
              RowBox[{"#", ",", "\"\<eff_min_\>\""}], "]"}]}]}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"base", "=", 
        RowBox[{"SelectFirst", "[", 
         RowBox[{
          RowBox[{"SortBy", "[", 
           RowBox[{"eff", ",", "StringLength"}], "]"}], ",", 
          RowBox[{"Function", "[", 
           RowBox[{"b", ",", 
            RowBox[{
             RowBox[{"Count", "[", 
              RowBox[{"eff", ",", 
               RowBox[{"c_", "/;", 
                RowBox[{"StringStartsQ", "[", 
                 RowBox[{"c", ",", 
                  RowBox[{"b", "<>", "\"\<_\>\""}]}], "]"}]}]}], "]"}], ">=", 
             "3"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cols", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"eff", ",", 
          RowBox[{
           RowBox[{"StringStartsQ", "[", 
            RowBox[{"#", ",", 
             RowBox[{"base", "<>", "\"\<_\>\""}]}], "]"}], "&"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<cols\>\"", "->", "cols"}], ",", 
         RowBox[{"\"\<names\>\"", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"StringDrop", "[", 
              RowBox[{"#", ",", 
               RowBox[{
                RowBox[{"StringLength", "[", "base", "]"}], "+", "1"}]}], 
              "]"}], "&"}], "/@", "cols"}], ")"}]}]}], "|>"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"One", " ", "record", " ", "per", " ", 
     RowBox[{"run", ":", "strategy"}]}], ",", 
    RowBox[{
     RowBox[{"Q", "'"}], " ", 
     RowBox[{"(", "optimized_main", ")"}]}], ",", 
    RowBox[{
     RowBox[{"Q", "''"}], " ", 
     RowBox[{"(", "optimized_sec", ")"}]}], ",", 
    RowBox[{"per", "-", 
     RowBox[{
     "signal", " ", "TEST", " ", "efficiencies", " ", "at", " ", "the", " ", 
      RowBox[{"run", "'"}], "s", " ", "own", " ", "strategy", " ", 
      "checkpoint"}]}], ",", 
    RowBox[{"and", " ", "their", " ", "mean", " ", "over", " ", "signal", " ", 
     RowBox[{"datasets", "."}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"loadRuns", "[", "exp_String", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"raw", ",", "hdr", ",", "idx", ",", "rows", ",", 
        RowBox[{"runs", "=", 
         RowBox[{"<|", "|>"}]}], ",", "eraw", ",", "ehdr", ",", "eidx", ",", 
        "erows", ",", "ps", ",", "rn", ",", "strat", ",", "arr", ",", "sig"}],
        "}"}], ",", 
      RowBox[{
       RowBox[{"raw", "=", 
        RowBox[{"Import", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"paretoEffsDir", ",", 
             RowBox[{"exp", "<>", "\"\<.csv\>\""}]}], "}"}], "]"}], ",", 
          "\"\<CSV\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"hdr", "=", 
        RowBox[{"First", "[", "raw", "]"}]}], ";", 
       RowBox[{"rows", "=", 
        RowBox[{"Rest", "[", "raw", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"idx", "=", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{"hdr", "->", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "hdr", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"row", "[", 
             RowBox[{"[", 
              RowBox[{"idx", "[", "\"\<ckpt\>\"", "]"}], "]"}], "]"}], "===", 
            "\"\<strategy\>\""}], ",", 
           RowBox[{
            RowBox[{"runs", "[", 
             RowBox[{"row", "[", 
              RowBox[{"[", 
               RowBox[{"idx", "[", "\"\<run_name\>\"", "]"}], "]"}], "]"}], 
             "]"}], "=", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<strategy\>\"", "->", 
               RowBox[{"row", "[", 
                RowBox[{"[", 
                 RowBox[{"idx", "[", "\"\<strategy\>\"", "]"}], "]"}], 
                "]"}]}], ",", 
              RowBox[{"\"\<q0\>\"", "->", 
               RowBox[{"numOrMissing", "[", 
                RowBox[{"row", "[", 
                 RowBox[{"[", 
                  RowBox[{"idx", "[", "\"\<optimized_main\>\"", "]"}], "]"}], 
                 "]"}], "]"}]}], ",", 
              RowBox[{"\"\<q1\>\"", "->", 
               RowBox[{"numOrMissing", "[", 
                RowBox[{"row", "[", 
                 RowBox[{"[", 
                  RowBox[{"idx", "[", "\"\<optimized_sec\>\"", "]"}], "]"}], 
                 "]"}], "]"}]}]}], "|>"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"row", ",", "rows"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"eraw", "=", 
        RowBox[{"Import", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"paretoEffsDir", ",", 
             RowBox[{"exp", "<>", "\"\<_eval.csv\>\""}]}], "}"}], "]"}], ",", 
          "\"\<CSV\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ehdr", "=", 
        RowBox[{"First", "[", "eraw", "]"}]}], ";", 
       RowBox[{"erows", "=", 
        RowBox[{"Rest", "[", "eraw", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"eidx", "=", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{"ehdr", "->", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "ehdr", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ps", "=", 
        RowBox[{"perSignalCols", "[", "ehdr", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"rn", "=", 
           RowBox[{"row", "[", 
            RowBox[{"[", 
             RowBox[{"eidx", "[", "\"\<run_name\>\"", "]"}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"KeyExistsQ", "[", 
              RowBox[{"runs", ",", "rn"}], "]"}], "&&", 
             RowBox[{
              RowBox[{"row", "[", 
               RowBox[{"[", 
                RowBox[{"eidx", "[", "\"\<split\>\"", "]"}], "]"}], "]"}], 
              "===", "\"\<test\>\""}], "&&", 
             RowBox[{"strategyContextQ", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"runs", "[", "rn", "]"}], "[", "\"\<strategy\>\"", 
                "]"}], ",", 
               RowBox[{"row", "[", 
                RowBox[{"[", 
                 RowBox[{"eidx", "[", "\"\<context\>\"", "]"}], "]"}], 
                "]"}]}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"arr", "=", 
              RowBox[{"AssociationThread", "[", 
               RowBox[{
                RowBox[{"ps", "[", "\"\<names\>\"", "]"}], "->", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"numOrMissing", "[", 
                    RowBox[{"row", "[", 
                    RowBox[{"[", 
                    RowBox[{"eidx", "[", "#", "]"}], "]"}], "]"}], "]"}], 
                   "&"}], "/@", 
                  RowBox[{"ps", "[", "\"\<cols\>\"", "]"}]}], ")"}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"sig", "=", 
              RowBox[{"DeleteMissing", "[", 
               RowBox[{"KeySelect", "[", 
                RowBox[{"arr", ",", 
                 RowBox[{
                  RowBox[{"!", 
                   RowBox[{"bkgDatasetQ", "[", "#", "]"}]}], "&"}]}], "]"}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "sig", "]"}], ">", "0"}], ",", 
               RowBox[{
                RowBox[{"runs", "[", "rn", "]"}], "=", 
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"runs", "[", "rn", "]"}], ",", 
                  RowBox[{"<|", 
                   RowBox[{
                    RowBox[{"\"\<testArr\>\"", "->", "sig"}], ",", 
                    RowBox[{"\"\<eff\>\"", "->", 
                    RowBox[{"Mean", "[", 
                    RowBox[{"Values", "[", "sig", "]"}], "]"}]}]}], "|>"}]}], 
                 "]"}]}]}], "]"}]}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"row", ",", "erows"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "runs"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"frontsOf", "[", "runs_Association", "]"}], ":=", 
   RowBox[{"GroupBy", "[", 
    RowBox[{"runs", ",", 
     RowBox[{
      RowBox[{"#", "[", "\"\<strategy\>\"", "]"}], "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.994166680014889*^9, 3.994166690365041*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"7b4fad46-1a8b-4647-ba0b-aa44fe6c7730"],

Cell["\<\
(* q99 retraining campaigns: experiment map. Both the history and the
   _eval.csv harvests exist, so the standard loadRuns/rebuttalRuns/
   rulePickArrays path applies unchanged: per-signal arrays are TEST-split
   efficiencies at each run's own strategy checkpoint, exactly as for the
   250 Hz experiments. *)
rebuttalModelExpsQ99 = <|\"AE\" -> \"physics_ae_q99_pareto\",
   \"VAE\" -> \"physics_vae_q99_pareto\", \"DSAE\" -> \
\"physics_dsae_q99_pareto\",
   \"DSVAE\" -> \"physics_dsvae_q99_pareto\", \"SVDD\" -> \
\"physics_svdd_q99_pareto\",
   \"RealNVP\" -> \"physics_realnvp_q99_pareto\",
   \"DTE\" -> \"physics_dte_q99_pareto\"|>;\
\>", "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"773ea748-d75c-49b6-86c9-d3bc1c016ad0"]
}, Closed]],

