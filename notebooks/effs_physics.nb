      RowBox[{"x_", ",", " ", "ref_"}], "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"NumericQ", "[", "x", "]"}], " ", "&&", " ", 
        RowBox[{"NumericQ", "[", "ref", "]"}]}], ",", "\n", "   ", 
       RowBox[{"fmtNum", "[", 
        RowBox[{
         RowBox[{"100", "*", 
          RowBox[{"(", 
           RowBox[{"x", " ", "-", " ", "ref"}], ")"}]}], ",", " ", "2"}], 
        "]"}], ",", " ", "\"\<-\>\""}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"One", " ", "rule"}], "-", 
     RowBox[{"table", " ", "row", " ", "per", " ", 
      RowBox[{"(", 
       RowBox[{"model", ",", " ", "strategy"}], ")"}], " ", 
