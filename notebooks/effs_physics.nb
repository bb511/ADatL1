         RowBox[{"Return", "[", 
          RowBox[{"Missing", "[", "\"\<LengthMismatch\>\"", "]"}], "]"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"d", "=", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{
          RowBox[{"a", "-", "b"}], ",", "0."}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"d", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Return", "[", "1.0", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"absd", "=", 
        RowBox[{"Abs", "[", "d", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sgn", "=", 
        RowBox[{"Sign", "[", "d", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
