   {\"dsvae\", \"q99\"} -> {0.186, 0.899},
   {\"svdd\", \"250Hz\"} -> {0.17, 0.81},
   {\"svdd\", \"q99\"} -> {0.17, 0.9},
   {\"realnvp\", \"250Hz\"} -> {0.639, 0.899},
   {\"realnvp\", \"q99\"} -> {0.639, 0.899}|>;\
\>", "Input",ExpressionUUID->"faaae685-752c-46d3-9cc8-4d48ade79615"],

Cell["\<\
Do[Module[{d = legacyEffs[m, tier], plot},
   plot = makeBoxCMS[
     Lookup[d, {\"semisupervised\", \"stable\", \"CAP\", \"wasserstein\"}],
     {\"semi-supervised\", \"stable\", \"CAP\", \"wasserstein\"},
     \"Efficiency (%)\", {0.085, 0.9}, {0.64, 0.9}, 1, 0.17,
     legacyModelLabel[m], legacyLabelPos[{m, tier}]];
   Export[\"effs/\" <> m <> \"_\" <> tier <> \".\" <> ToLowerCase[#],
      plot, #] & /@ {\"SVG\", \"PDF\", \"JPEG\"}],
  {m, {\"ae\", \"vae\", \"dsae\", \"dsvae\", \"svdd\", \"realnvp\"}},
  {tier, {\"250Hz\", \"q99\"}}]\
\>", "Input",ExpressionUUID->"9a1c44cc-f379-4322-a5c2-5991ab496b84"]
}, Closed]],

Cell[CellGroupData[{

Cell["3. Quantile Comparison", "Subsection",ExpressionUUID->"30f23910-ab00-4960-aacd-7623103cf208"],

Cell["\<\
Axis 1: both operating points side by side; the Holm family is per operating \
point, consistent with the main tables.\
\>", "Text",ExpressionUUID->"d1b41412-3181-438a-9b8b-9fec8db0df95"],

Cell["\<\
printTable[QuantileAxisLatex[allArchitectures250hz, allArchitecturesQ99]];
printTable[QuantileAxisMarkdown[allArchitectures250hz, allArchitecturesQ99]];\
\
\>", "Input",ExpressionUUID->"29926a15-4bf8-4827-84bc-fd334a31d210"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Best Q'", "Section",ExpressionUUID->"c07cdb06-8538-4b93-bdbb-b4465230b10c"],

Cell["\<\
Rule: from each front, take the retrained point whose recomputed strategy \
objective Q' is best. Tables carry bootstrap CIs and Holm-adjusted Wilcoxon \
p-values; the grid exports as grouped_bestq_250Hz. The quantile comparison \
applies the rule independently to the 250 Hz and q99 campaigns (disjoint \
trial sets from their own searches).\
\>", "Text",ExpressionUUID->"3a235080-ca0c-4485-816c-e9ae7ba171e0"],

Cell[CellGroupData[{

Cell["250 Hz", "Subsubsection",
 CellChangeTimes->{{3.994647927537977*^9, 
  3.9946479284793262`*^9}},ExpressionUUID->"8f3b8c6f-8986-42e6-9671-\
5a9863bbb2ee"],

Cell[CellGroupData[{

Cell["\<\
bestqGroups = rulePickArrays[rebuttalModelExps, bestQPick];
bestqTabRows = \
HolmAdjustRows[BuildArchitectureRowsCompactCollapse[toLegacyGroups[\
bestqGroups], 10000, 0.05]];
printTable[LatexTableFromRows[bestqTabRows, 2]];
printTable[MarkdownTableFromRows[bestqTabRows, 2]];\
\>", "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"c332cedd-e90e-4760-abb7-3df4455f4a24"],

