        RowBox[{"1.0", ",", 
         RowBox[{"2.0", " ", 
          RowBox[{"Min", "[", 
           RowBox[{"pLeft", ",", "pRight"}], "]"}]}]}], "]"}]}]}], "]"}]}], 
