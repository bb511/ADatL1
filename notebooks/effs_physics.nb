Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"secObjLabel", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<mse\>\"", "->", "\"\<MSE\>\""}], ",", 
       RowBox[{"\"\<mseq99\>\"", "->", "\"\<MSE\>\""}], ",", 
       RowBox[{"\"\<kl\>\"", "->", "\"\<KL\>\""}], ",", 
       RowBox[{"\"\<dist\>\"", "->", "\"\<dist\>\""}], ",", 
       RowBox[{"\"\<logp\>\"", "->", "\"\<-log p\>\""}]}], "|>"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"studyFile", "[", 
      RowBox[{"frontsDir_String", ",", "model_String", ",", "strat_String"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "cands", "}"}], ",", 
       RowBox[{
        RowBox[{"cands", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"FileNames", "[", 
            RowBox[{
             RowBox[{"model", "<>", "\"\<_\>\"", "<>", 
              RowBox[{"strategyStudyObj", "[", "strat", "]"}], "<>", 
              "\"\<_vs_*.csv\>\""}], ",", "frontsDir"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"!", 
              RowBox[{"StringContainsQ", "[", 
               RowBox[{"#", ",", "\"\<q99\>\""}], "]"}]}], "&&", 
             RowBox[{"!", 
              RowBox[{"StringContainsQ", "[", 
               RowBox[{"#", ",", "\"\<exploration\>\""}], "]"}]}]}], "&"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"cands", "===", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"Missing", "[", "\"\<NoStudy\>\"", "]"}], ",", 
          RowBox[{"First", "[", 
           RowBox[{"Sort", "[", "cands", "]"}], "]"}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"makeFrontPlot", "[", 
      RowBox[{
      "frontsDir_String", ",", "model_String", ",", "strat_String", ",", 
       "modelLabel_String"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "file", ",", "raw", ",", "hdr", ",", "idx", ",", "rows", ",", "pts", 
         ",", "front", ",", "dom", ",", "secName", ",", "xlab", ",", "ylab"}],
         "}"}], ",", 
       RowBox[{
        RowBox[{"file", "=", 
         RowBox[{"studyFile", "[", 
          RowBox[{"frontsDir", ",", "model", ",", "strat"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MissingQ", "[", "file", "]"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Missing", "[", "\"\<NoStudy\>\"", "]"}], "]"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"raw", "=", 
         RowBox[{"Import", "[", 
          RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"hdr", "=", 
         RowBox[{"First", "[", "raw", "]"}]}], ";", 
        RowBox[{"rows", "=", 
         RowBox[{"Rest", "[", "raw", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"idx", "=", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{"hdr", "->", 
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "hdr", "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pts", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"rows", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"idx", "[", "\"\<values_0\>\"", "]"}], "]"}], "]"}], 
              "]"}], "&&", 
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"idx", "[", "\"\<values_1\>\"", "]"}], "]"}], "]"}], 
              "]"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"front", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"pts", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"ToString", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"idx", "[", "\"\<is_pareto\>\"", "]"}], "]"}], "]"}], 
              "]"}], "===", "\"\<True\>\""}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dom", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"pts", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"ToString", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"idx", "[", "\"\<is_pareto\>\"", "]"}], "]"}], "]"}], 
              "]"}], "=!=", "\"\<True\>\""}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"secName", "=", 
         RowBox[{"StringReplace", "[", 
          RowBox[{
           RowBox[{"FileBaseName", "[", "file", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"model", "<>", "\"\<_\>\"", "<>", 
               RowBox[{"strategyStudyObj", "[", "strat", "]"}], "<>", 
               "\"\<_vs_\>\""}], "->", "\"\<\>\""}], ",", 
             RowBox[{"\"\<_b16k\>\"", "->", "\"\<\>\""}]}], "}"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"xlab", "=", 
         RowBox[{
          RowBox[{"strategyPretty", "[", "strat", "]"}], "<>", 
          "\"\< objective\>\""}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ylab", "=", 
         RowBox[{"Lookup", "[", 
          RowBox[{"secObjLabel", ",", "secName", ",", "secName"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"dom", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"idx", "[", "\"\<values_0\>\"", "]"}], ",", 
                 RowBox[{"idx", "[", "\"\<values_1\>\"", "]"}]}], "}"}]}], 
              "]"}], "]"}], ",", 
            RowBox[{"front", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"idx", "[", "\"\<values_0\>\"", "]"}], ",", 
                 RowBox[{"idx", "[", "\"\<values_1\>\"", "]"}]}], "}"}]}], 
              "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"GrayLevel", "[", "0.75", "]"}], ",", 
               RowBox[{"PointSize", "[", "0.008", "]"}]}], "]"}], ",", 
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"RGBColor", "[", "\"\<#bd1f01\>\"", "]"}], ",", 
               RowBox[{"PointSize", "[", "0.014", "]"}]}], "]"}]}], "}"}]}], 
          ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"Axes", "->", "False"}], ",", 
          RowBox[{"FrameStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{"Black", ",", 
             RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}], ",", 
          RowBox[{"FrameTicksStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{"Black", ",", 
             RowBox[{"FontSize", "->", "16"}], ",", 
             RowBox[{"FontFamily", "->", "\"\<TeX Gyre Heros\>\""}]}], 
            "]"}]}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"xlab", ",", "18", ",", 
               RowBox[{"FontFamily", "->", "\"\<TeX Gyre Heros\>\""}]}], 
              "]"}], ",", 
             RowBox[{"Style", "[", 
              RowBox[{"ylab", ",", "18", ",", 
               RowBox[{"FontFamily", "->", "\"\<TeX Gyre Heros\>\""}]}], 
              "]"}]}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"modelLabel", "<>", "\"\<: \>\"", "<>", 
              RowBox[{"strategyPretty", "[", "strat", "]"}]}], ",", "18", ",", 
             RowBox[{"FontFamily", "->", "\"\<TeX Gyre Heros\>\""}]}], 
            "]"}]}], ",", 
          RowBox[{"ImageSize", "->", "420"}], ",", 
          RowBox[{"AspectRatio", "->", "0.8"}], ",", 
          RowBox[{"PlotRangePadding", "->", 
           RowBox[{"Scaled", "[", "0.05", "]"}]}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"modelFrontRow", "[", 
      RowBox[{
      "frontsDir_String", ",", "model_String", ",", "modelLabel_String"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "plots", "}"}], ",", 
       RowBox[{
        RowBox[{"plots", "=", 
         RowBox[{"DeleteMissing", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"makeFrontPlot", "[", 
             RowBox[{"frontsDir", ",", "model", ",", "#", ",", "modelLabel"}],
              "]"}], "&"}], "/@", 
           RowBox[{"{", 
            RowBox[{
            "\"\<cvar25\>\"", ",", "\"\<stability\>\"", ",", "\"\<cap\>\"", 
             ",", "\"\<wasserstein\>\""}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"plots", "===", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"Missing", "[", "\"\<NoStudies\>\"", "]"}], ",", 
          RowBox[{"GraphicsRow", "[", 
           RowBox[{"plots", ",", 
            RowBox[{"ImageSize", "->", 
             RowBox[{"420", "*", 
              RowBox[{"Length", "[", "plots", "]"}]}]}], ",", 
            RowBox[{"Spacings", "->", "0"}]}], "]"}]}], "]"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9941674232854233`*^9, 3.994167423982819*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"f5ca9479-4be8-483b-b10c-c3d1a0090b6a"]
