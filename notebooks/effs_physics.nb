Cell[CellGroupData[{

Cell["Pareto Knee Selection", "Section",ExpressionUUID->"e9cd3d46-19d8-4019-a308-0a672bc3815c"],

Cell["\<\
Rule: min-max normalise both recomputed objectives over the front and take \
the point furthest from the chord joining the endpoints (kneePick). Same \
tables, grid (grouped_knee_250Hz) and quantile axis as Best Q'.\
\>", "Text",ExpressionUUID->"489e3de9-48ac-4caf-a351-ed6e16740175"],

Cell[CellGroupData[{

Cell["250 Hz", "Subsubsection",
 CellChangeTimes->{{3.9946479485948353`*^9, 
  3.994647950812407*^9}},ExpressionUUID->"20b4e72b-6a3f-4a46-a800-\
e5c2ca622cd5"],

Cell["\<\
kneeGroups = rulePickArrays[rebuttalModelExps, kneePick];
kneeTabRows = \
HolmAdjustRows[BuildArchitectureRowsCompactCollapse[toLegacyGroups[kneeGroups]\
, 10000, 0.05]];
printTable[LatexTableFromRows[kneeTabRows, 2]];
printTable[MarkdownTableFromRows[kneeTabRows, 2]];\
\>", "Input",ExpressionUUID->"16fd66b1-a59c-4613-8e4f-5cffe37dc919"]
}, Closed]],

Cell[CellGroupData[{

Cell["Plots", "Subsubsection",
 CellChangeTimes->{{3.994647960137764*^9, 
  3.994647960637945*^9}},ExpressionUUID->"06e2d8bc-0016-41cb-80a4-\
c4fb8adaffe3"],

Cell["\<\
kneePlot = makeRuleBoxGrid[dropEmptyModels[kneeGroups], 2]
Export[rebuttalOutDir <> \"grouped_knee\" <> rebuttalTierSuffix <> \".svg\", \
kneePlot, \"SVG\"];
Export[rebuttalOutDir <> \"grouped_knee\" <> rebuttalTierSuffix <> \".pdf\", \
kneePlot, \"PDF\"];
Export[rebuttalOutDir <> \"grouped_knee\" <> rebuttalTierSuffix <> \".jpeg\", \
kneePlot, \"JPEG\"];\
\>", "Input",ExpressionUUID->"5d505f6d-fcc0-45e4-8e89-ee48551ba2e1"]
}, Closed]],

