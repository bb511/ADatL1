           RowBox[{
            RowBox[{"mid", "=", 
             RowBox[{"Mean", "[", 
              RowBox[{"Range", "[", 
               RowBox[{"start", ",", 
                RowBox[{"start", "+", "len", "-", "1"}]}], "]"}], "]"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"ranks", "[", 
              RowBox[{"[", 
               RowBox[{"sortedIdx", "[", 
                RowBox[{"[", "g", "]"}], "]"}], "]"}], "]"}], "=", "mid"}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"start", "+=", "len"}], ";"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"g", ",", "groups"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wPlus", "=", 
        RowBox[{"Total", "[", 
         RowBox[{"Pick", "[", 
          RowBox[{"ranks", ",", "sgn", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"allSums", "=", 
        RowBox[{"Total", "/@", 
         RowBox[{"(", 
          RowBox[{
