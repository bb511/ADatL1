       RowBox[{"pickF", "[", 
        RowBox[{"front", ",", " ", "strat"}], "]"}]}], " ", "must", "\n", 
      "   ", "return", " ", "a", " ", "run", " ", "name", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"or", " ", "Missing"}], ")"}], "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ruleTableRows", "[", 
      RowBox[{
      "modelExps_Association", ",", " ", "domain_String", ",", " ", 
       "pickF_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rows", " ", "=", " ", 
         RowBox[{"{", "}"}]}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"model", " ", "=", " ", "modelKey"}], ",", " ", 
              RowBox[{"exp", " ", "=", " ", 
               RowBox[{"modelExps", "[", "modelKey", "]"}]}], ",", " ", 
              "runs", ",", " ", "fronts"}], "}"}], ",", "\n", "    ", 
            RowBox[{
             RowBox[{"runs", " ", "=", " ", 
              RowBox[{"rebuttalRuns", "[", "exp", "]"}]}], ";", "\n", "    ", 
             
             RowBox[{"fronts", " ", "=", " ", 
