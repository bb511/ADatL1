             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", "n"}], "]"}]}], ")"}]}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"pLeft", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"Count", "[", 
