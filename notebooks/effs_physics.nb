Cell[CellGroupData[{

Cell["Pareto Knee Selection", "Section",
 CellChangeTimes->{{3.9941660223449697`*^9, 
  3.994166030761642*^9}},ExpressionUUID->"8f11b33d-524d-4e02-948e-\
ba563ca871e6"],

Cell[CellGroupData[{

Cell["\<\
kneeGroups = rulePickArrays[rebuttalModelExps, kneePick];
kneeTabRows = \
HolmAdjustRows[BuildArchitectureRowsCompactCollapse[toLegacyGroups[kneeGroups]\
, 10000, 0.05]];
printTable[LatexTableFromRows[kneeTabRows, 2]];
printTable[MarkdownTableFromRows[kneeTabRows, 2]];\
\>", "Input",
 CellLabel->
  "In[334]:=",ExpressionUUID->"8c500761-27fb-4843-b47e-b142d4a39c83"],

Cell[BoxData["\<\"\\\\begin{tabular}{lcccccccc}\\n\\\\toprule\\nArch. & Semi \
& CAP & Stable & W1 & CAP$-$Stable & $p$ & CAP$-$W1 & $p$ \
\\\\\\\\\\n\\\\midrule\\nAE & 3.99 & 3.53 & no-pick & 3.30 & n/a & n/a & \
$0.23^{+0.22}_{-0.19}$ & 0.200 \\\\\\\\\\nVAE & 4.77 & 4.70 & 4.62 & 4.55 & \
$0.07^{+0.40}_{-0.39}$ & 1.000 & $0.15^{+0.67}_{-0.73}$ & 1.000 \
\\\\\\\\\\nDSAE & 7.32 & 7.30 & no-pick & 4.15 & n/a & n/a & \
$3.14^{+2.51}_{-2.12}$ & 0.107 \\\\\\\\\\nDSVAE & 5.16 & 0.02 & no-pick & \
no-pick & n/a & n/a & n/a & n/a \\\\\\\\\\nSVDD & coll & 3.82 & 0.06 & \
no-pick & $3.75^{+2.38}_{-2.00}$ & <0.001 & n/a & n/a \\\\\\\\\\nRealNVP & \
3.92 & 2.25 & 3.33 & 1.77 & $-1.08^{+0.59}_{-0.64}$ & <0.001 & \
$0.49^{+0.37}_{-0.35}$ & 0.041 \
\\\\\\\\\\n\\\\bottomrule\\n\\\\end{tabular}\\n% legend: no-pick = rule could \
not select from this front (knee needs >= 3 Pareto points, best-Q' needs >= \
1); coll = method collapsed (all-zero) or excluded by the saturation guard; \
n/a = comparison not computable (a required side is missing).\"\>"], "Print",
