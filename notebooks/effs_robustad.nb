{80.65, 83.33, 76.92, 76.92, 76.92, 76.92}]]; 

(* AUPRC table. The fire-on-everything guard is switched off here: a
   saturated AUPRC column means perfect separation, not a degenerate
   detector, so it must not be dashed out. *)
Block[{$degenerateGuard = False},
  printTable[BuildLatexTableCompactAsymCollapse[robustadAUPRCArchitectures, 10000, \
0.05, 2]];
  printTable[BuildMarkdownTableCompactAsymCollapse[robustadAUPRCArchitectures, \
10000, 0.05, 2]];
]\
