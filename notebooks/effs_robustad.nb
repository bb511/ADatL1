Cell[CellGroupData[{

Cell["\<\
frontRowSVDD = modelFrontRow[rebuttalFrontsDir, \"svdd\", \"SVDD\"]
Export[rebuttalOutDir <> \"fronts_svdd\" <> rebuttalTierSuffix <> \".svg\", \
frontRowSVDD, \"SVG\"];
Export[rebuttalOutDir <> \"fronts_svdd\" <> rebuttalTierSuffix <> \".pdf\", \
frontRowSVDD, \"PDF\"];\
\>", "Input",
 CellLabel->
  "In[185]:=",ExpressionUUID->"310b879d-9ae5-43ca-8caa-6a0394b6dd8c"],

