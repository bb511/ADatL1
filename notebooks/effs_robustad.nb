Cell[CellGroupData[{

Cell["Pareto Knee Selection", "Section",ExpressionUUID->"685a2e88-5b8c-414e-8127-13137207a273"],

Cell[CellGroupData[{

Cell["\<\
kneeGroups = rulePickArrays[rebuttalModelExps, kneePick];
kneeTabRows = HolmAdjustRows[BuildArchitectureRowsCompactCollapse[
   toLegacyGroups[kneeGroups], 10000, 0.05]];
printTable[LatexTableFromRows[kneeTabRows, 2]];
printTable[MarkdownTableFromRows[kneeTabRows, 2]];\
\>", "Input",
 CellLabel->
  "In[211]:=",ExpressionUUID->"20d0d18e-f735-4a9b-9fbe-18340c04b23c"],

Cell[CellGroupData[{

Cell[BoxData["\<\"\\\\begin{tabular}{lcccccccc}\\n\\\\toprule\\nArch. & Semi \
& CAP & Stable & W1 & CAP$-$Stable & $p$ & CAP$-$W1 & $p$ \
\\\\\\\\\\n\\\\midrule\\nAE & no-pick & 88.46 & no-pick & 72.44 & n/a & n/a & \
$16.02^{+8.43}_{-8.61}$ & 0.125 \\\\\\\\\\nVAE & 100.00 & 16.61 & no-pick & \
25.48 & n/a & n/a & $-8.87^{+19.44}_{-18.72}$ & 0.875 \\\\\\\\\\nSVDD & \
no-pick & 99.50 & no-pick & 100.00 & n/a & n/a & $-0.50^{+0.50}_{-0.61}$ & \
0.875 \\\\\\\\\\nRealNVP & no-pick & 70.69 & no-pick & 100.00 & n/a & n/a & \
$-29.31^{+18.11}_{-23.46}$ & 0.125 \
\\\\\\\\\\n\\\\bottomrule\\n\\\\end{tabular}\\n% legend: no-pick = rule could \
not select from this front (knee needs >= 3 Pareto points, best-Q' needs >= \
1); coll = method collapsed (all-zero) or excluded by the saturation guard; \
n/a = comparison not computable (a required side is missing).\"\>"], "Print",
 CellChangeTimes->{3.994221643172289*^9, 3.994222061512698*^9, 
  3.994222166273326*^9, 3.994225892236073*^9},
 CellLabel->
  "During evaluation of \
In[211]:=",ExpressionUUID->"326289b2-a21f-4d4e-bd13-d658babbaaba"],

Cell[BoxData["\<\"| Arch. | Semi | CAP | Stable | W1 | CAP-Stable | p | \
CAP-W1 | p |\\n|---|---|---|---|---|---|---|---|---|\\n| AE | no-pick | 88.46 \
| no-pick | 72.44 | n/a | n/a | $16.02^{+8.43}_{-8.61}$ | 0.125 |\\n| VAE | \
100.00 | 16.61 | no-pick | 25.48 | n/a | n/a | $-8.87^{+19.44}_{-18.72}$ | \
0.875 |\\n| SVDD | no-pick | 99.50 | no-pick | 100.00 | n/a | n/a | \
$-0.50^{+0.50}_{-0.61}$ | 0.875 |\\n| RealNVP | no-pick | 70.69 | no-pick | \
100.00 | n/a | n/a | $-29.31^{+18.11}_{-23.46}$ | 0.125 |\\n\\nlegend: \
no-pick = rule could not select from this front (knee needs >= 3 Pareto \
points, best-Q' needs >= 1); coll = method collapsed (all-zero) or excluded \
by the saturation guard; n/a = comparison not computable (a required side is \
