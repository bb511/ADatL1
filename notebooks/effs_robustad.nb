Cell[CellGroupData[{

Cell["Pareto Knee Selection", "Section",ExpressionUUID->"a3d42bc5-a4bf-4505-acbf-1dd3519db00e"],

Cell["\<\
Rule: min-max normalise both recomputed objectives over the front and take \
the point furthest from the chord joining the endpoints (kneePick). Same \
table and grid as Best Q'; the grid exports as grouped_knee.\
\>", "Text",ExpressionUUID->"ba692e4b-acff-4002-afea-70dd1a8a7e22"],

Cell[CellGroupData[{

Cell["\<\
kneeGroups = rulePickArrays[rebuttalModelExps, kneePick];
kneeTabRows = HolmAdjustRows[BuildArchitectureRowsCompactCollapse[
   toLegacyGroups[kneeGroups], 10000, 0.05]];
printTable[LatexTableFromRows[kneeTabRows, 2]];
printTable[MarkdownTableFromRows[kneeTabRows, 2]];\
\>", "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"8af2dfd0-17ff-4bdb-92e9-80134f0ab4c0"],

