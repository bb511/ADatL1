frontRowAE = modelFrontRow[rebuttalFrontsDir, \"ae\", \"AE\"]
Export[rebuttalOutDir <> \"fronts_ae\" <> rebuttalTierSuffix <> \".svg\", \
frontRowAE, \"SVG\"];
Export[rebuttalOutDir <> \"fronts_ae\" <> rebuttalTierSuffix <> \".pdf\", \
frontRowAE, \"PDF\"];\
