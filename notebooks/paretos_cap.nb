(* Beginning of Notebook Content *)
Notebook[{
Cell[CellGroupData[{
Cell["\<\
Pareto Fronts for the CAP Optimisations\
\>", "Title"],

Cell["\<\
Pareto fronts of the CAP hyper-parameter optimisation sweeps: the final publication fronts (semi-supervised, stability, CAP, wasserstein) and one diagnostic front per CAP variant explored during the search.

Inputs: paretos/cap_optimisation/<study>.csv, exported from the Optuna databases by scripts/fetch_optuna_pareto.py. Figures land in paretos/cap_optimisation/plots/ (the ae/drift finals additionally in paretos/). Methods live in notebooks/lib/pareto_cap_lib.wl; run top-to-bottom, or headlessly via scripts/nb_run.wls.

Note: makeParetoPlot now takes named options instead of 17 positional arguments. The old search-section calls passed too few positional arguments to match the definition at all, so those sections had been exporting images of the unevaluated expression; with options they fall back to defaults and render real fronts again.\
\>", "Text"],

Cell[CellGroupData[{
Cell["\<\
Setup\
\>", "Chapter"],

Cell["\<\
makeParetoPlot[data, opts]: \"XLabel\"/\"YLabel\" (axis labels), \"ZoomRange\" (the {{x0,x1},{y0,y1}} window of the inset), \"ZoomedPlotPos\"/\"ZoomedPlotSize\" (inset placement, Scaled), \"RangePadding\", \"LegendPos\"/\"CMSPos\"/\"TeVPos\" (annotation anchors, Scaled), \"PrecX\"/\"PrecY\" (tick decimals), \"ShowZoom\"/\"ShowZoomBox\" (inset and its dashed source box), \"LogLog\", \"InvertLines\" (which inset corners the connector lines attach to), \"HighlightTrials\" (trial numbers drawn as chosen points). Defaults are the values shared by most sections; each cell states only what it overrides.\
\>", "Text"],

Cell["\<\
SetDirectory[NotebookDirectory[]];
Get[FileNameJoin[{NotebookDirectory[], \"lib\", \"pareto_cap_lib.wl\"}]];\
\>", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["\<\
Final Plots\
\>", "Chapter"],

Cell[CellGroupData[{
Cell["\<\
Semi-Supervised Pareto Front\
\>", "Section"],

Cell["\<\
CVaR25 efficiency vs MSE front; zoom on the knee region.\
\>", "Text"],

Cell["\<\
res = loadParetoData[\"cvar25eff_vs_mse_b16k\"];
plot = makeParetoPlot[res,
  \"XLabel\" -> \"\\!\\(\\*SubscriptBox[\\(CVaR\\), \\(25\\)]\\)(\\[ScriptCapitalE])\",
  \"ZoomRange\" -> {{0.75, 1.5}, {0.2, 0.5}},
  \"ZoomedPlotPos\" -> {0.27, 0.2},
  \"ZoomedPlotSize\" -> {0.6, 0.75},
  \"RangePadding\" -> {{Scaled[0.02], Scaled[0.05]}, {Scaled[0.055], Scaled[0.07]}},
  \"CMSPos\" -> {0.1, 0.93}]
exportParetoPlot[plot, \"cvar25eff_vs_mse_b16k\", \"paretos/cap_optimisation/plots\", {\"SVG\"}];\
\>", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["\<\
Stability Pareto Front\
\>", "Section"],

Cell["\<\
MSE vs threshold-drift front; no zoom inset. Exported to paretos/ for the paper.\
\>", "Text"],

Cell["\<\
res = loadParetoData[\"mse_vs_drift_b16k\"];
plot = makeParetoPlot[res,
  \"XLabel\" -> \"\\!\\(\\*SubscriptBox[\\(MSE\\), \\(250 Hz\\)]\\)\",
  \"YLabel\" -> \"\\!\\(\\*RowBox[{\\\"ln\\\", \\\"(\\\", FractionBox[RowBox[{OverscriptBox[\\\"FPR\\\", \\\"^\\\"], \\\"+\\\", \\\"\\[Epsilon]\\\"}], RowBox[{\\\"FPR\\\", \\\"+\\\", \\\"\\[Epsilon]\\\"}]], \\\")\\\"}]\\)\",
  \"ZoomRange\" -> {{0.75, 1.5}, {0.15, 0.5}},
  \"ZoomedPlotPos\" -> {0.27, 0.2},
  \"ZoomedPlotSize\" -> {0.6, 0.75},
  \"RangePadding\" -> {{Scaled[0.02], Scaled[0.05]}, {Scaled[0.055], Scaled[0.07]}},
  \"LegendPos\" -> {0.05, 0.82},
  \"CMSPos\" -> {0.115, 0.93},
  \"TeVPos\" -> {0.835, 0.925},
  \"ShowZoom\" -> False,
  \"ShowZoomBox\" -> False]
exportParetoPlot[plot, \"mse_vs_drift_b16k\", \"paretos\", {\"SVG\"}];\
\>", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["\<\
CAP Pareto Front\
\>", "Section"],

Cell["\<\
CAP vs reconstruction-loss fronts for the AE (exported to paretos/ for the paper) and the VAE, each with its chosen trial highlighted.\
\>", "Text"],

Cell["\<\
res = loadParetoData[\"cap_vs_mse_b16k_ae\"];
plot = makeParetoPlot[res,
  \"ZoomRange\" -> {{-0.3, -0.21}, {0.15, 0.5}},
  \"ZoomedPlotPos\" -> {0.27, 0.2},
  \"ZoomedPlotSize\" -> {0.6, 0.75},
  \"RangePadding\" -> {{Scaled[0.05], Scaled[0.09]}, {Scaled[-0.15], Scaled[0.07]}},
  \"TeVPos\" -> {0.58, 0.925},
  \"ShowZoom\" -> False,
  \"ShowZoomBox\" -> False,
  \"HighlightTrials\" -> {229}]
exportParetoPlot[plot, \"cap_vs_mse_b16k_ae\", \"paretos\", {\"SVG\", \"PDF\"}];\
\>", "Input"],

Cell["\<\
res = loadParetoData[\"cap_vs_mse_b16k_vae\"];
plot = makeParetoPlot[res,
  \"YLabel\" -> \"\\!\\(\\*SubscriptBox[\\(KL\\), \\(250 Hz\\)]\\)\",
  \"ZoomRange\" -> {{-0.3, -0.1}, {0.15, 0.5}},
  \"ZoomedPlotPos\" -> {0.27, 0.2},
  \"ZoomedPlotSize\" -> {0.6, 0.75},
  \"RangePadding\" -> {{Scaled[0.07], Scaled[0.12]}, {Scaled[0.07], Scaled[0.09]}},
  \"TeVPos\" -> {0.585, 0.925},
  \"PrecY\" -> 0,
  \"ShowZoom\" -> False,
  \"ShowZoomBox\" -> False,
  \"HighlightTrials\" -> {179}]
exportParetoPlot[plot, \"cap_vs_mse_b16k_vae\", \"paretos/cap_optimisation/plots\", {\"SVG\", \"PDF\"}];\
\>", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["\<\
Wasserstein Pareto Front\
\>", "Section"],

Cell["\<\
W1 distance vs MSE front; inverted connector lines because the inset sits below the cloud.\
\>", "Text"],

Cell["\<\
res = loadParetoData[\"wasserstein_vs_mse_b16k\"];
plot = makeParetoPlot[res,
  \"XLabel\" -> \"\\!\\(\\*SubscriptBox[\\(W\\), \\(1\\)]\\)(\\!\\(\\*StyleBox[\\\"X\\\", FontWeight->\\\"Bold\\\", FontSlant->\\\"Plain\\\"]\\), \\!\\(\\*SubscriptBox[StyleBox[\\\"X\\\", FontWeight->\\\"Bold\\\", FontSlant->\\\"Plain\\\"], \\(sim\\)]\\))\",
  \"ZoomRange\" -> {{0.00055, 0.00082}, {0.13, 0.5}},
  \"ZoomedPlotPos\" -> {0.17, 0.05},
  \"ZoomedPlotSize\" -> {0.6, 0.75},
  \"RangePadding\" -> {{Scaled[0.02], Scaled[0.05]}, {Scaled[0.055], Scaled[0.07]}},
  \"LegendPos\" -> {0.85, 0.1},
  \"TeVPos\" -> {0.805, 0.925},
  \"PrecX\" -> 3,
  \"InvertLines\" -> True]
exportParetoPlot[plot, \"wasserstein_vs_mse_b16k\", \"paretos/cap_optimisation/plots\", {\"SVG\"}];\
\>", "Input"]
}, Open]]
}, Open]],

Cell[CellGroupData[{
Cell["\<\
CAP Hyper-parameter Search\
\>", "Chapter"],

Cell["\<\
One diagnostic front per CAP variant explored during the search (normalisation x energy function x pairing x scale/beta). All variants share the default plot options; the table lists, per study, only the axis label and the zoom-window overrides. The driver below renders and exports every row as SVG + PDF.

The labels are kept verbatim from the original sections (including the two whose label disagrees with the study name).\
\>", "Text"],

Cell["\<\
capSearchTable = {
   <|\"data\" -> \"capSigmoidBaseline_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Baseline\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.355, -0.319}, {0.15, 0.5}}}|>,
   <|\"data\" -> \"capSigmoidMargin_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Margin\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.282, -0.246}, {0.15, 0.5}}}|>,
   <|\"data\" -> \"capSigmoidAdaptive_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Adaptive\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.273, -0.227}, {0.15, 0.5}}}|>,
   <|\"data\" -> \"capMinmaxBaseline_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> MinMax | Energy |-> Baseline\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.2195, -0.21911}, {0.15, 0.5}}, \"ZoomedPlotPos\" -> {0.2, 0.33}}|>,
   <|\"data\" -> \"capSigmoidFocal_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Focal\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.44, -0.375}, {0.15, 0.5}}}|>,
   <|\"data\" -> \"capSigmoidExponential_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Exponential\",
    \"opts\" -> {\"ZoomedPlotPos\" -> {0.1, 0.33}}|>,
   <|\"data\" -> \"capSigmoidBaselineRnd_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Adaptive | Random Pair\",
    \"opts\" -> {\"ZoomedPlotPos\" -> {0.1, 0.33}}|>,
   <|\"data\" -> \"capSigmoidFocalRnd_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Focal | Random Pair\",
    \"opts\" -> {\"ZoomedPlotPos\" -> {0.1, 0.33}}|>,
   <|\"data\" -> \"capSigmoidBaselineRndReal_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Baseline | Random Pair\",
    \"opts\" -> {\"ZoomedPlotPos\" -> {0.1, 0.33}}|>,
   <|\"data\" -> \"capSigmoidAdaptiveAbs_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Adaptive | Absolute Pair\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.2, -0.09}, {0.15, 0.5}}}|>,
   <|\"data\" -> \"capSigmoidBaselineAbs_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Baseline | Absolute Pair\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.5, -0.35}, {0.15, 0.5}}}|>,
   <|\"data\" -> \"capSigmoidFocalAbs_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Focal | Absolute Pair\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.38, -0.18}, {0.15, 0.5}}}|>,
   <|\"data\" -> \"capSigmoidAdaptiveScale025_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Adaptive | Scale=0.25\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.38, -0.23}, {0.15, 0.5}}}|>,
   <|\"data\" -> \"capSigmoidAdaptiveScale1_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Adaptive | Scale=1\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.33, -0.22}, {0.15, 0.5}}}|>,
   <|\"data\" -> \"capSigmoidAdaptiveBeta01_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Adaptive | Beta=0.1\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.33, -0.24}, {0.15, 0.5}}}|>,
   <|\"data\" -> \"capSigmoidAdaptiveBeta5_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Adaptive | Beta=5\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.25, -0.15}, {0.15, 0.5}}}|>,
   <|\"data\" -> \"capSigmoidAdaptiveRankmidNorm_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Adaptive | Rankmid Norm\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.25, -0.15}, {0.15, 0.5}}}|>,
   <|\"data\" -> \"capSigmoidAdaptiveRankNorm_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Adaptive | Rank Norm\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.25, -0.15}, {0.15, 0.5}}}|>,
   <|\"data\" -> \"capSigmoidAdaptiveLogSigmoidNorm_vs_mse_b16k\",
    \"label\" -> \"CAP(ZB, SN) | Norm |-> Sigmoid | Energy |-> Adaptive | Log Sigmoid Norm\",
    \"opts\" -> {\"ZoomRange\" -> {{-0.25, -0.175}, {0.15, 0.5}}}|>};\
\>", "Input"],

Cell["\<\
Do[Module[{res = loadParetoData[row[\"data\"]], plot},
   plot = makeParetoPlot[res, \"XLabel\" -> row[\"label\"],
     Sequence @@ row[\"opts\"]];
   exportParetoPlot[plot, row[\"data\"],
     \"paretos/cap_optimisation/plots\", {\"SVG\", \"PDF\"}]],
  {row, capSearchTable}]\
\>", "Input"]
}, Open]]
}, Open]]
},
WindowSize->{1200, 900},
StyleDefinitions->"Default.nb"
]
(* End of Notebook Content *)
